# Valores por defecto (desarrollo). Las variables reales del entorno tienen
# prioridad; los secretos van en .env.local (no versionado) o en el entorno.
# Mismos nombres que la configuración del backend actual: el mismo .env sirve.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=
APP_SHARE_DIR=var/share
###< symfony/framework-bundle ###

DEFAULT_URI=http://localhost

# --- Aplicación ---
ENVIRONMENT=development
PROJECT_NAME="Sistema Inventario TI"
API_V1_STR=/api/v1

# --- Oracle Database 21c (oci8) ---
ORACLE_HOST=localhost
ORACLE_PORT=1521
ORACLE_SERVICE_NAME=XEPDB1
ORACLE_USER=INVENTARIO
ORACLE_PASSWORD=
# Dueño de las tablas cuando la API se conecta con un usuario de ejecución.
ORACLE_SCHEMA_OWNER=
DB_RLS_ENABLED=true

# --- Seguridad (SECRET_KEY: mínimo 32 caracteres; compartida con el backend actual) ---
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
SESSION_ABSOLUTE_MAX_HOURS=720
SESSION_IDLE_TIMEOUT_MINUTES=120
REFRESH_COOKIE_PERSISTENT=false
ACCOUNT_LOCKOUT_THRESHOLD=5
ACCOUNT_LOCKOUT_MINUTES=15
ACCOUNT_LOCKOUT_MAX_MINUTES=1440
ACCOUNT_LOCKOUT_RESET_HOURS=24
TWO_FACTOR_CHALLENGE_EXPIRE_MINUTES=5
TWO_FACTOR_REQUIRED_ROLES=SUPER_ADMIN,ADMIN_SEGURIDAD,ADMIN_TI
SESSION_HISTORY_DAYS=180
AUTH_CACHE_TTL_SECONDS=30
RATE_LIMIT_LOGIN=5/minute
# Lista JSON de orígenes permitidos, p. ej. ["https://inventario.empresa.com"]
BACKEND_CORS_ORIGINS=[]

# --- Redis (opcional: caché de autenticación y límites compartidos) ---
REDIS_URL=

RATE_LIMIT_REFRESH=30/minute
REFRESH_REUSE_GRACE_SECONDS=30
PASSWORD_RESET_EXPIRE_MINUTES=30
PASSWORD_RESET_REQUEST_COOLDOWN_MINUTES=2
TWO_FACTOR_ISSUER="Inventario Lombardi"
TWO_FACTOR_EMAIL_OTP_EXPIRE_MINUTES=10
TWO_FACTOR_MAX_ATTEMPTS=5
TWO_FACTOR_RECOVERY_CODES=8
NEW_DEVICE_ALERT_ENABLED=true
FRONTEND_BASE_URL=https://localhost

# --- Política de contraseñas ---
PASSWORD_MIN_LENGTH=10
PASSWORD_REQUIRE_UPPER=true
PASSWORD_REQUIRE_LOWER=true
PASSWORD_REQUIRE_DIGIT=true
PASSWORD_REQUIRE_SYMBOL=false
PASSWORD_HISTORY_COUNT=3
PASSWORD_BLOCKED_WORDS=lombardi,inventario,password,contrasena,contraseña,admin,bienvenido,welcome

# --- Cifrado de campos (Fernet, primera clave cifra) y HMAC (obligatorios en producción) ---
FIELD_ENCRYPTION_KEY=
HMAC_KEYS=

# --- Correo (fallback si SYS_INTEGRACION_CORREO no está configurada) ---
EMAIL_ENABLED=true
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_TLS=true
SMTP_STARTTLS=true
SMTP_TIMEOUT_SECONDS=10
SMTP_FROM_EMAIL=noreply@lombardi.local
SMTP_FROM_NAME="Sistema Inventario Lombardi"
NOTIFY_ADMIN_EMAILS=
ORG_TIMEZONE=America/Guatemala
RATE_LIMIT_DEFAULT=100/minute

# --- SSO OpenID Connect (Microsoft Entra ID / Google Workspace) ---
SSO_ENABLED=false
SSO_ALLOWED_EMAIL_DOMAINS=
SSO_MFA_LOCAL=true
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=organizations
SSO_MICROSOFT_ALLOWED_TENANT_IDS=
SSO_MICROSOFT_REDIRECT_URI=
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URI=
