# Variables propias de la API PHP en producción (copiar a deploy/.env.php, no versionado).
# El resto (Oracle, Redis, MinIO, SECRET_KEY, HMAC_KEYS, FIELD_ENCRYPTION_KEY, SMTP,
# SSO, respaldos…) va en deploy/.env: los MISMOS valores que el stack anterior
# (tokens, hashes y datos cifrados siguen valiendo, y la reversión es posible).
# Generar: openssl rand -hex 32
APP_SECRET=
FRANKENPHP_WORKERS=4
