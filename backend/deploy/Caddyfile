# =========================================================================
# Caddy del stack de producción: TLS (CA privada de Caddy con TLS_EMISOR=internal,
# o Let's Encrypt con un correo), cabeceras de seguridad y enrutamiento:
#
#   /metrics, /health/full      403 (operativos: solo por la red interna)
#   /api/*, /health y
#   /.well-known/mercure       API PHP (api_php:8000): toda la API y los avisos en vivo (SSE)
#   todo lo demás               frontend (Nginx: la aplicación React)
#
# =========================================================================

{
    email {$ACME_EMAIL:admin@example.com}
    # Quien entra por IP no envía SNI: este nombre elige su certificado.
    default_sni {$TLS_DEFAULT_SNI:localhost}
    # Conexiones lentas a propósito (slowloris): quien no termina de enviar sus cabeceras en 10 s
    # o deja la conexión sin uso 3 min la pierde. Sin tope de escritura: los avisos en vivo (SSE)
    # mantienen la respuesta abierta. Las cabeceras de una petición legítima caben en 32 KB.
    servers {
        timeouts {
            read_header 10s
            read_body 5m
            idle 3m
        }
        max_header_size 32KB
    }
    log {
        output stderr
        format json
        level INFO
    }
}

{$DOMAIN:localhost} {
    # internal: CA privada de Caddy (red interna). Con un correo, Let's Encrypt.
    tls {$TLS_EMISOR:internal}
    encode zstd gzip

    # Registro de accesos (JSON en stdout; la rotación la hace Docker).
    log {
        output stdout
        format json
    }

    header {
        Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
        Referrer-Policy "strict-origin-when-cross-origin"
        # camera=(self): el escáner QR/código de barras usa la cámara.
        Permissions-Policy "geolocation=(), microphone=(), camera=(self), payment=(), usb=(), interest-cohort=(), browsing-topics=(), fullscreen=(self), accelerometer=(), gyroscope=(), magnetometer=()"
        Cross-Origin-Opener-Policy "same-origin"
        Cross-Origin-Resource-Policy "same-origin"
        -Server
        -X-Powered-By
    }

    # No exponer endpoints operativos por el edge público.
    @internal_only path /metrics /health/full
    handle @internal_only {
        respond "Forbidden" 403
    }

    @api path /api /api/* /health /.well-known/mercure
    handle @api {
        # El borde corta lo que PHP igual rechazaría (post_max_size = 18M) antes de que llegue a la API.
        request_body {
            max_size 20MB
        }
        reverse_proxy api_php:8000 {
            # Si la API se reinicia (despliegue o caída), espera hasta 10 s en vez de
            # devolver 502. Solo reintenta lo que no llegó a enviarse.
            lb_try_duration 10s
            lb_try_interval 250ms
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }

    handle {
        reverse_proxy frontend:80 {
            lb_try_duration 10s
            lb_try_interval 250ms
            header_up X-Real-IP {remote_host}
            header_up X-Forwarded-For {remote_host}
            header_up X-Forwarded-Proto {scheme}
            header_up Host {host}
        }
    }
}
