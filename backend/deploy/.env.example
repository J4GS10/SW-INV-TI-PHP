# Plantilla de deploy/.env (producción). No lleva secretos y sí se versiona.
# La crea `bash herramientas/generar_env.sh`, que genera las claves; luego se
# editan a mano solo las secciones marcadas con «EDITAR». Guía: docs/PUESTA_EN_MARCHA.md.
# Lo que no aparece aquí toma el valor por defecto de docker-compose.yml.

# --- Sitio (EDITAR) -----------------------------------------------------------
# Nombres o IP por los que se entra, separados por coma. Cada uno recibe su certificado.
DOMAIN=inventario.empresa.local
# Los mismos, con https://, en formato JSON.
BACKEND_CORS_ORIGINS=["https://inventario.empresa.local"]
# Dirección que aparece en los enlaces de los correos.
FRONTEND_BASE_URL=https://inventario.empresa.local
# Certificado que se entrega a quien entra por IP (no envía nombre).
TLS_DEFAULT_SNI=inventario.empresa.local
# internal = CA privada de Caddy. Para Let's Encrypt, un correo (requiere dominio público y puertos 80 y 443 abiertos).
TLS_EMISOR=internal
COMPANY_NAME=Nombre de la empresa
ORG_TIMEZONE=America/Guatemala

# --- Cuenta raíz ----------------------------------------------------------------
SUPER_ADMIN_USERNAME=sa
SUPER_ADMIN_EMAIL=admin@empresa.local
# Vacía: el migrador genera una temporal, la muestra una vez en su log y obliga a cambiarla al entrar.
SUPER_ADMIN_PASSWORD=
MFA_CAN_BE_DISABLED=false
# Días desde el alta en que se puede dejar el MFA para más tarde (0 = obligatorio desde el primer ingreso).
MFA_ENROLL_GRACE_DAYS=7
# Días que un equipo recordado no pide el código (0 = no se ofrece).
MFA_REMEMBER_DAYS=30
# Máximo de días de una excepción del MFA que concede el administrador del sistema.
MFA_EXEMPTION_MAX_DAYS=30

# --- Respaldos (EDITAR) -----------------------------------------------------------
# Ruta absoluta en el servidor, fuera de la carpeta del repositorio.
BACKUP_DIR=/srv/inventario/respaldos
# Copia en otro disco o en un recurso de red montado. Se activa con COMPOSE_PROFILES=replica.
COMPOSE_PROFILES=replica
BACKUP_REPLICA_DIR=/mnt/respaldo-externo/inventario

# --- Correo (más adelante) ----------------------------------------------------------
# Vacío: no sale ningún correo. También se puede configurar desde la aplicación.
SMTP_HOST=
SMTP_PORT=587
SMTP_STARTTLS=true
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Inventario TI
NOTIFY_ADMIN_EMAILS=

# --- Conexiones internas ------------------------------------------------------------
# Por defecto, los nombres de los servicios en la red de Docker (una sola VM).
# Solo cambian si los datos pasan a otra VM: use su nombre DNS, nunca una IP.
# ORACLE_HOST=oracle
# ORACLE_PORT=1521
# ORACLE_SERVICE_NAME=XEPDB1
# REDIS_HOST=redis
# S3_ENDPOINT_URL=http://minio:9000

# --- Secretos (los genera generar_env.sh; no editar) ----------------------------------
# Guárdelos también en un gestor de contraseñas: sin las cuatro claves de cifrado
# (SECRET_KEY, HMAC_KEYS, FIELD_ENCRYPTION_KEY, MINIO_KMS_SECRET_KEY) un respaldo no sirve.
ORACLE_SYS_PASSWORD=
ORACLE_SCHEMA_OWNER=INVENTARIO
ORACLE_OWNER_PASSWORD=
ORACLE_APP_USER=INVENTARIO_APP
ORACLE_APP_PASSWORD=
REDIS_PASSWORD=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=
MINIO_APP_USER=
MINIO_APP_PASSWORD=
MINIO_KMS_SECRET_KEY=
SECRET_KEY=
HMAC_KEYS=
FIELD_ENCRYPTION_KEY=
